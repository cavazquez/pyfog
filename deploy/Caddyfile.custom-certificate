{
	admin off
	auto_https disable_redirects
}

http://{$PYFOG_PUBLIC_HOST} {
	redir https://{host}{uri} permanent
}

https://{$PYFOG_PUBLIC_HOST} {
	tls /run/secrets/pyfog_tls_certificate /run/secrets/pyfog_tls_private_key
	handle_path /boot/* {
		reverse_proxy pxe:8080
	}
	handle {
		reverse_proxy app:8000
	}
}
