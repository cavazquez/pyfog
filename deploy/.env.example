# Nombre DNS incluido en el certificado y permitido por PyFog.
PYFOG_PUBLIC_HOST=pyfog.lab.test

# Archivo local con 32 o más caracteres aleatorios. No versionarlo.
PYFOG_SESSION_KEY_FILE=./secrets/session-key

