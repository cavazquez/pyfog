# Nombre DNS incluido en el certificado y permitido por PyFog.
PYFOG_PUBLIC_HOST=pyfog.lab.test

# Opcional: interfaz/puerto público de desarrollo y publicación PXE estática.
# PYFOG_BIND_ADDRESS=0.0.0.0
# PYFOG_DEV_BIND=127.0.0.1
# PYFOG_DEV_PORT=8000
# PYFOG_PXE_DIR=../dist/pxe

# Sólo desarrollo; en LAN usar PYFOG_SECRET_KEY_FILE y el gestor de secretos.
# PYFOG_DEV_SECRET_KEY=pyfog-development-only-session-key-change-me

# Archivo local con 32 o más caracteres aleatorios. No versionarlo.
PYFOG_SESSION_KEY_FILE=./secrets/session-key

# Sólo para compose.custom-certificate.yaml.
# PYFOG_TLS_CERTIFICATE_FILE=./secrets/server-fullchain.pem
# PYFOG_TLS_PRIVATE_KEY_FILE=./secrets/server-key.pem
