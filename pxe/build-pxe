#!/usr/bin/env bash
# Build a small, immutable iPXE publication around a verified PyFog agent.
set -Eeuo pipefail

umask 022

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
readonly SCRIPT_DIR PROJECT_ROOT
readonly TEMPLATE="$SCRIPT_DIR/boot.ipxe.tmpl"
readonly AGENT_BUILDER="$PROJECT_ROOT/agent/build-agent"

OUTPUT_DIR="$PROJECT_ROOT/dist/pxe"
AGENT_DIR="$PROJECT_ROOT/dist/agent"
BASE_URL=""
SERVER_URL=""
IPXE_EFI=""
PROFILE_ONLY=0
SECURE_BOOT=0
SIGNING_KEY=""
SIGNING_CERT=""
SECURE_BOOT_CERT=""
TIMEOUT_MS=5000
VERSION=""
SOURCE_DATE_EPOCH_VALUE="${SOURCE_DATE_EPOCH:-1704067200}"

error() {
    printf 'build-pxe: error: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Uso:
  pxe/build-pxe doctor
  pxe/build-pxe build --base-url https://host/boot [opciones]
  pxe/build-pxe verify [--output-dir DIR]

Opciones de build:
  --agent-dir DIR       Artefactos del agente (por defecto: dist/agent)
  --output-dir DIR      Publicación PXE (por defecto: dist/pxe)
  --base-url URL        Raíz HTTPS sin credenciales, query ni fragmento
  --server-url URL      API HTTPS de PyFog; por defecto, el origen de --base-url
  --ipxe-efi PATH       Binario UEFI iPXE para la raíz TFTP
  --profile-only        Generar el script sin exigir --ipxe-efi
  --secure-boot         Firmar los artefactos EFI con --signing-key/--signing-cert
  --signing-key PATH    Clave privada externa del firmador (sólo con --secure-boot)
  --signing-cert PATH   Certificado público del firmador (sólo con --secure-boot)
  --timeout-ms N        Timeout del menú; por defecto 5000, entre 1000 y 60000
  --version VERSION     Versión del agente; por defecto, la del manifiesto
  --source-date-epoch N Fecha fija de archivos, en segundos UTC

Opciones de verify:
  --secure-boot-cert PATH  Certificado público para validar firmas Authenticode
EOF
}

parse_options() {
    while (($# > 0)); do
        case "$1" in
            --agent-dir)
                (($# >= 2)) || error "--agent-dir requiere un valor"
                AGENT_DIR=$2
                shift 2
                ;;
            --output-dir)
                (($# >= 2)) || error "--output-dir requiere un valor"
                OUTPUT_DIR=$2
                shift 2
                ;;
            --base-url)
                (($# >= 2)) || error "--base-url requiere un valor"
                BASE_URL=$2
                shift 2
                ;;
            --server-url)
                (($# >= 2)) || error "--server-url requiere un valor"
                SERVER_URL=$2
                shift 2
                ;;
            --ipxe-efi)
                (($# >= 2)) || error "--ipxe-efi requiere un valor"
                IPXE_EFI=$2
                shift 2
                ;;
            --profile-only)
                PROFILE_ONLY=1
                shift
                ;;
            --secure-boot)
                SECURE_BOOT=1
                shift
                ;;
            --signing-key)
                (($# >= 2)) || error "--signing-key requiere un valor"
                SIGNING_KEY=$2
                shift 2
                ;;
            --signing-cert)
                (($# >= 2)) || error "--signing-cert requiere un valor"
                SIGNING_CERT=$2
                shift 2
                ;;
            --secure-boot-cert)
                (($# >= 2)) || error "--secure-boot-cert requiere un valor"
                SECURE_BOOT_CERT=$2
                shift 2
                ;;
            --timeout-ms)
                (($# >= 2)) || error "--timeout-ms requiere un valor"
                TIMEOUT_MS=$2
                shift 2
                ;;
            --version)
                (($# >= 2)) || error "--version requiere un valor"
                VERSION=$2
                shift 2
                ;;
            --source-date-epoch)
                (($# >= 2)) || error "--source-date-epoch requiere un valor"
                SOURCE_DATE_EPOCH_VALUE=$2
                shift 2
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                error "opción desconocida: $1"
                ;;
        esac
    done
    [[ "$TIMEOUT_MS" =~ ^[0-9]+$ && "$TIMEOUT_MS" -ge 1000 && "$TIMEOUT_MS" -le 60000 ]] \
        || error "--timeout-ms debe ser un entero entre 1000 y 60000"
    [[ "$SOURCE_DATE_EPOCH_VALUE" =~ ^[0-9]+$ ]] \
        || error "--source-date-epoch debe ser un entero no negativo"
    if [ "$SECURE_BOOT" -eq 1 ]; then
        [ -n "$SIGNING_KEY" ] || error "--secure-boot requiere --signing-key"
        [ -n "$SIGNING_CERT" ] || error "--secure-boot requiere --signing-cert"
        [ "$PROFILE_ONLY" -eq 0 ] || error "--secure-boot requiere un binario --ipxe-efi"
    elif [ -n "$SIGNING_KEY" ] || [ -n "$SIGNING_CERT" ]; then
        error "--signing-key/--signing-cert sólo se usan junto con --secure-boot"
    fi
}

doctor() {
    local missing=0 command_name
    for command_name in bash python3 install cp sha256sum touch mktemp; do
        if command -v "$command_name" >/dev/null 2>&1; then
            printf 'OK       %s\n' "$command_name"
        else
            printf 'FALTA    %s\n' "$command_name" >&2
            missing=1
        fi
    done
    for command_name in osslsigncode sbverify; do
        if command -v "$command_name" >/dev/null 2>&1; then
            printf 'OK       %s (Secure Boot)\n' "$command_name"
        else
            printf 'AVISO    %s (necesario sólo con --secure-boot)\n' "$command_name"
        fi
    done
    [[ -x "$AGENT_BUILDER" ]] || {
        printf 'FALTA    agent/build-agent\n' >&2
        missing=1
    }
    [[ -f "$TEMPLATE" ]] || {
        printf 'FALTA    pxe/boot.ipxe.tmpl\n' >&2
        missing=1
    }
    return "$missing"
}

validate_base_url() {
    [ -n "$BASE_URL" ] || error "--base-url es obligatorio"
    BASE_URL=$(
        python3 - "$BASE_URL" <<'PY'
from urllib.parse import urlsplit, urlunsplit
import sys

value = sys.argv[1]
parsed = urlsplit(value)
if (
    parsed.scheme != "https"
    or not parsed.hostname
    or parsed.username
    or parsed.password
    or parsed.query
    or parsed.fragment
    or not value.isascii()
    or any(char.isspace() for char in value)
    or any(char in value for char in (";", "'", '"', "`", "$", "{", "}"))
):
    raise SystemExit("la URL debe ser HTTPS, con host y sin credenciales, query o fragmento")
if parsed.port is not None and not 1 <= parsed.port <= 65535:
    raise SystemExit("el puerto de la URL no es válido")
print(urlunsplit((parsed.scheme, parsed.netloc, parsed.path.rstrip("/"), "", "")))
PY
    ) || error "--base-url inválida"
}

validate_server_url() {
    SERVER_URL=$(
        python3 - "$SERVER_URL" <<'PY'
from urllib.parse import urlsplit, urlunsplit
import sys

value = sys.argv[1]
try:
    parsed = urlsplit(value)
    hostname = parsed.hostname
    port = parsed.port
except ValueError:
    raise SystemExit("la URL del servidor no es válida")
if (
    parsed.scheme != "https"
    or not hostname
    or parsed.username
    or parsed.password
    or parsed.query
    or parsed.fragment
    or parsed.path not in {"", "/"}
    or not value.isascii()
    or any(char.isspace() for char in value)
    or any(char in value for char in (";", "'", '"', "`", "$", "{", "}"))
):
    raise SystemExit("la URL del servidor debe ser HTTPS, raíz y sin credenciales")
if port is not None and not 1 <= port <= 65535:
    raise SystemExit("el puerto de la URL del servidor no es válido")
print(urlunsplit((parsed.scheme, parsed.netloc, "", "", "")))
PY
    ) || error "--server-url inválida"
}

read_agent_metadata() {
    [ -d "$AGENT_DIR" ] || error "no existe el directorio del agente: $AGENT_DIR"
    for file in vmlinuz initramfs.img manifest.json SHA256SUMS; do
        [ -f "$AGENT_DIR/$file" ] || error "falta $AGENT_DIR/$file"
    done
    "$AGENT_BUILDER" verify --output-dir "$AGENT_DIR" >/dev/null \
        || error "el agente no supera la verificación de hashes"
    local metadata
    metadata=$(python3 - "$AGENT_DIR/manifest.json" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
value = json.loads(path.read_text(encoding="utf-8"))
if value.get("schema_version") != 1 or value.get("format") != "pyfog-agent-initramfs":
    raise SystemExit("manifiesto de agente incompatible")
if "inventory" not in value.get("capabilities", []):
    raise SystemExit("el agente no declara capacidad inventory")
print(value["agent_version"])
PY
    ) || error "no se pudo leer el manifiesto del agente"
    if [ -z "$VERSION" ]; then
        VERSION=$metadata
    fi
    [[ "$VERSION" =~ ^[A-Za-z0-9._+-]+$ ]] || error "versión de agente inválida"
}

build() {
    local work source_dir http_dir tftp_dir manifest_path sums_path
    validate_base_url
    if [ -z "$SERVER_URL" ]; then
        SERVER_URL=$(python3 - "$BASE_URL" <<'PY'
from urllib.parse import urlsplit, urlunsplit
import sys

parsed = urlsplit(sys.argv[1])
print(urlunsplit((parsed.scheme, parsed.netloc, "", "", "")))
PY
        ) || error "no se pudo derivar --server-url"
    fi
    validate_server_url
    read_agent_metadata
    if [ "$PROFILE_ONLY" -eq 0 ]; then
        [ -n "$IPXE_EFI" ] || error "--ipxe-efi es obligatorio (o use --profile-only)"
        [ -r "$IPXE_EFI" ] || error "no se puede leer el binario iPXE: $IPXE_EFI"
    fi
    work=$(mktemp -d "${TMPDIR:-/tmp}/pyfog-pxe.XXXXXX")
    trap 'rm -rf -- "$work"' EXIT
    source_dir="$work/http/agent"
    http_dir="$work/http"
    tftp_dir="$work/tftp"
    mkdir -p "$source_dir" "$tftp_dir"
    for file in vmlinuz initramfs.img manifest.json SHA256SUMS; do
        install -m 0644 "$AGENT_DIR/$file" "$source_dir/$file"
    done
    if [ -n "$IPXE_EFI" ]; then
        install -m 0644 "$IPXE_EFI" "$tftp_dir/ipxe.efi"
    fi
    python3 - "$TEMPLATE" "$tftp_dir/boot.ipxe" "$BASE_URL" "$SERVER_URL" "$VERSION" "$TIMEOUT_MS" <<'PY'
import pathlib
import sys

template_path = pathlib.Path(sys.argv[1])
output_path = pathlib.Path(sys.argv[2])
base_url, server_url, version, timeout = sys.argv[3:7]
content = template_path.read_text(encoding="utf-8")
for placeholder, value in {
    "__PYFOG_BASE_URL__": base_url,
    "__PYFOG_SERVER_URL__": server_url,
    "__PYFOG_AGENT_VERSION__": version,
    "__PYFOG_TIMEOUT_MS__": timeout,
}.items():
    content = content.replace(placeholder, value)
if "__PYFOG_" in content:
    raise SystemExit("quedó un placeholder sin reemplazar en boot.ipxe")
output_path.write_text(content, encoding="utf-8")
PY
    if [ "$SECURE_BOOT" -eq 1 ]; then
        local signed_work
        signed_work=$(mktemp -d "${TMPDIR:-/tmp}/pyfog-pxe-signed.XXXXXX")
        python3 "$PROJECT_ROOT/scripts/secure_boot_artifacts.py" sign \
            --input-dir "$work" \
            --output-dir "$signed_work" \
            --key "$SIGNING_KEY" \
            --cert "$SIGNING_CERT" \
            --source-date-epoch "$SOURCE_DATE_EPOCH_VALUE" \
            || error "no se pudo firmar la publicación EFI"
        rm -rf -- "$work"
        work="$signed_work"
        source_dir="$work/http/agent"
        http_dir="$work/http"
        tftp_dir="$work/tftp"
    fi
    manifest_path="$work/manifest.json"
    sums_path="$work/SHA256SUMS"
    python3 - "$manifest_path" "$http_dir" "$tftp_dir" "$BASE_URL" "$SERVER_URL" "$VERSION" "$TIMEOUT_MS" \
        "$SOURCE_DATE_EPOCH_VALUE" <<'PY'
import hashlib
import json
import pathlib
import sys

manifest_path = pathlib.Path(sys.argv[1])
http_dir = pathlib.Path(sys.argv[2])
tftp_dir = pathlib.Path(sys.argv[3])
base_url, server_url, version, timeout, epoch = sys.argv[4:9]

def digest(path: pathlib.Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()

files = []
for root, prefix in ((http_dir, "http"), (tftp_dir, "tftp")):
    for path in sorted(root.rglob("*")):
        if path.is_file():
            files.append(
                {
                    "path": (path.relative_to(manifest_path.parent)).as_posix(),
                    "sha256": digest(path),
                    "size": path.stat().st_size,
                }
            )
secure_manifest = manifest_path.parent / "secure-boot-manifest.json"
if secure_manifest.is_file():
    files.append(
        {
            "path": secure_manifest.name,
            "sha256": digest(secure_manifest),
            "size": secure_manifest.stat().st_size,
        }
    )
metadata = {
    "schema_version": 1,
    "format": "pyfog-pxe-profile",
    "profile_version": version,
    "base_url": base_url,
    "server_url": server_url,
    "menu_timeout_ms": int(timeout),
    "source_date_epoch": int(epoch),
    "files": files,
}
manifest_path.write_text(
    json.dumps(metadata, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8"
)
PY
    python3 - "$sums_path" "$work" <<'PY'
import hashlib
import pathlib
import sys

output, root = map(pathlib.Path, sys.argv[1:])
lines = []
for path in sorted(root.rglob("*")):
    if path.is_file() and path != root / "SHA256SUMS":
        lines.append(f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.relative_to(root).as_posix()}")
output.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
    # Normalize before the atomic publication. The output contains only regular files.
    find "$work" -type f -exec touch -h -d "@$SOURCE_DATE_EPOCH_VALUE" {} +
    mkdir -p "$OUTPUT_DIR"
    rm -rf -- "$OUTPUT_DIR/http" "$OUTPUT_DIR/tftp"
    install -d "$OUTPUT_DIR/http" "$OUTPUT_DIR/tftp"
    cp -a --no-preserve=ownership "$work/http/." "$OUTPUT_DIR/http/"
    cp -a --no-preserve=ownership "$work/tftp/." "$OUTPUT_DIR/tftp/"
    install -m 0644 "$manifest_path" "$OUTPUT_DIR/manifest.json"
    install -m 0644 "$sums_path" "$OUTPUT_DIR/SHA256SUMS"
    if [ -f "$work/secure-boot-manifest.json" ]; then
        install -m 0644 "$work/secure-boot-manifest.json" "$OUTPUT_DIR/secure-boot-manifest.json"
        touch -d "@$SOURCE_DATE_EPOCH_VALUE" "$OUTPUT_DIR/secure-boot-manifest.json"
    fi
    touch -d "@$SOURCE_DATE_EPOCH_VALUE" "$OUTPUT_DIR/manifest.json" "$OUTPUT_DIR/SHA256SUMS"
    trap - EXIT
    rm -rf -- "$work"
    printf 'Perfil PXE %s publicado en %s\n' "$VERSION" "$OUTPUT_DIR"
}

verify() {
    local directory=$OUTPUT_DIR manifest
    manifest="$directory/manifest.json"
    [ -f "$manifest" ] || error "falta $manifest"
    [ -f "$directory/SHA256SUMS" ] || error "falta $directory/SHA256SUMS"
    python3 - "$manifest" "$directory" <<'PY'
import hashlib
import json
import pathlib
import sys

manifest_path, root = map(pathlib.Path, sys.argv[1:])
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
if manifest.get("schema_version") != 1 or manifest.get("format") != "pyfog-pxe-profile":
    raise SystemExit("manifiesto PXE incompatible")
for item in manifest.get("files", []):
    path = root / item["path"]
    if not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest() != item["sha256"]:
        raise SystemExit(f"hash inválido o archivo faltante: {item['path']}")
print("Manifiesto PXE y hashes válidos.")
PY
    (cd "$directory" && sha256sum --check --strict SHA256SUMS)
    if [ -f "$directory/secure-boot-manifest.json" ]; then
        [ -n "$SECURE_BOOT_CERT" ] || error \
            "el bundle incluye firmas Secure Boot; indique --secure-boot-cert para verificarlas"
        python3 "$PROJECT_ROOT/scripts/secure_boot_artifacts.py" verify \
            --input-dir "$directory" --cert "$SECURE_BOOT_CERT"
    fi
}

command_name=${1:-}
[ -n "$command_name" ] || {
    usage
    exit 2
}
shift

case "$command_name" in
    doctor)
        (($# == 0)) || error "doctor no recibe argumentos"
        doctor
        ;;
    build)
        parse_options "$@"
        build
        ;;
    verify)
        parse_options "$@"
        verify
        ;;
    --help|-h)
        usage
        ;;
    *)
        error "comando desconocido: $command_name"
        ;;
esac
